<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle of the job in the chain. Enqueued means the job is waiting in the chain or running, written when Track Job Progress is on; the rest are outcomes: whether it ran (completed/failed) or was skipped and why.</description>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>ENQUEUED</fullName>
                <default>false</default>
                <label>Enqueued</label>
            </value>
            <value>
                <fullName>COMPLETED</fullName>
                <default>false</default>
                <label>Completed</label>
            </value>
            <value>
                <fullName>FAILED</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>SKIPPED_DEPENDENCY</fullName>
                <default>false</default>
                <label>Skipped - Dependency</label>
            </value>
            <value>
                <fullName>SKIPPED_CHAIN_STOPPED</fullName>
                <default>false</default>
                <label>Skipped - Chain Stopped</label>
            </value>
            <value>
                <fullName>SKIPPED_CHUNK_STOPPED</fullName>
                <default>false</default>
                <label>Skipped - Chunk Run Stopped</label>
            </value>
            <value>
                <fullName>SKIPPED_EXPLICIT</fullName>
                <default>false</default>
                <label>Skipped - Explicit</label>
            </value>
            <value>
                <fullName>SKIPPED_DISABLED</fullName>
                <default>false</default>
                <label>Skipped - Disabled</label>
            </value>
            <value>
                <fullName>FRAMEWORK_ERROR</fullName>
                <default>false</default>
                <label>Framework Error</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
